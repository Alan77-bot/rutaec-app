generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["rutaec"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agenda_bus {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativa_id String                    @db.Uuid
  bus_id         String                    @db.Uuid
  tipo           String
  inicio         DateTime                  @db.Timestamptz(6)
  fin            DateTime                  @db.Timestamptz(6)
  activa         Boolean                   @default(true)
  motivo         String?
  periodo        Unsupported("tstzrange")? @default(dbgenerated("tstzrange(inicio, fin, '[)'::text)"))
  buses          buses                     @relation(fields: [bus_id, cooperativa_id], references: [id, cooperativa_id], onDelete: NoAction, onUpdate: NoAction)
  cooperativas   cooperativas              @relation(fields: [cooperativa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  viajes         viajes?

  @@unique([id, bus_id, cooperativa_id])
  @@schema("rutaec")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model archivos {
  id                                                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propietario_id                                      String                @db.Uuid
  cooperativa_id                                      String?               @db.Uuid
  objeto_clave                                        String                @unique
  finalidad                                           String
  nombre_original                                     String
  mime_type                                           String
  tamano_bytes                                        BigInt
  sha256                                              String                @db.Char(64)
  estado                                              String                @default("PENDIENTE")
  privado                                             Boolean               @default(true)
  creado_en                                           DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  eliminado_en                                        DateTime?             @db.Timestamptz(6)
  cooperativas_archivos_cooperativa_idTocooperativas  cooperativas?         @relation("archivos_cooperativa_idTocooperativas", fields: [cooperativa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios                                            usuarios              @relation(fields: [propietario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  boletos                                             boletos[]
  comprobantes_pago                                   comprobantes_pago?
  cooperativas_cooperativas_logo_archivo_idToarchivos cooperativas[]        @relation("cooperativas_logo_archivo_idToarchivos")
  documentos_pasajero                                 documentos_pasajero[]
  envios_correo                                       envios_correo[]
  resoluciones                                        resoluciones[]

  @@index([propietario_id], map: "archivos_propietario_idx")
  @@schema("rutaec")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asientos_bus {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bus_id       String  @db.Uuid
  numero       String
  piso         Int     @db.SmallInt
  fila         Int     @db.SmallInt
  columna      Int     @db.SmallInt
  categoria    String
  preferencial Boolean @default(false)
  accesible    Boolean @default(false)
  activo       Boolean @default(true)
  buses        buses   @relation(fields: [bus_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([bus_id, numero])
  @@unique([bus_id, piso, fila, columna])
  @@unique([id, bus_id])
  @@schema("rutaec")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asientos_viaje {
  viaje_id       String           @db.Uuid
