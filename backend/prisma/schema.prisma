  frecuencias        frecuencias      @relation(fields: [frecuencia_id, ruta_id, cooperativa_id], references: [id, ruta_id, cooperativa_id], onDelete: NoAction, onUpdate: NoAction)
  hojas_ruta         hojas_ruta       @relation(fields: [hoja_ruta_id, cooperativa_id], references: [id, cooperativa_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, cooperativa_id])
  @@index([bus_id], map: "viajes_bus_idx")
  @@index([cooperativa_id, estado, cierre_ventas], map: "viajes_cooperativa_idx")
  @@schema("rutaec")
}
