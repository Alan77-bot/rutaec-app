model auditoria {
  id              BigInt        @id @default(autoincrement())
  actor_id        String?       @db.Uuid
  cooperativa_id  String?       @db.Uuid
  entidad         String
  entidad_id      String?       @db.Uuid
  accion          String
  estado_anterior String?
  estado_nuevo    String?
  correlacion_id  String?       @db.Uuid
  creado_en       DateTime      @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  usuarios        usuarios?     @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cooperativas    cooperativas? @relation(fields: [cooperativa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cooperativa_id, creado_en(sort: Desc)], map: "auditoria_fecha_idx")
