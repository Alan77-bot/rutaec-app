# ========================================================
# CONFIGURACIÓN DE BASE DE DATOS LOCAL (DOCKER POSTGRES)
# ========================================================
POSTGRES_USER=rutaec_admin
POSTGRES_PASSWORD=rutaec_secure_password
POSTGRES_DB=rutaec_db
POSTGRES_PORT=5433

# ========================================================
# CONEXIÓN BACKEND / PRISMA
# ========================================================
# Conexión local a Docker:
DATABASE_URL="postgresql://rutaec_admin:rutaec_secure_password@localhost:5433/rutaec_db?schema=rutaec"
# Conexión remota alternativa (Neon.tech):
# DATABASE_URL="postgresql://usuario:password@ep-sample-123.us-east-2.aws.neon.tech/rutaec_db?sslmode=require&schema=rutaec"

PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_rutaec_2026
FRONTEND_URL=http://localhost:5173

# ========================================================
# SERVICIO DE NOTIFICACIONES (RESEND / SMTP)
# ========================================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_123456789
EMAIL_FROM=notificaciones@rutaec.com

# ========================================================
# ALMACENAMIENTO DE ARCHIVOS (COMPROBANTES / LOGOS)
# ========================================================
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
